; Engine configuration file.
config_version=5

[application]
config/name="Space Dogfighter"
config/description="90s low-poly boomer shooter in space"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Net="*res://scripts/net.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
pitch_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0),
Object(InputEventKey,"device":-1,"physical_keycode":4194320)]
}
pitch_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0),
